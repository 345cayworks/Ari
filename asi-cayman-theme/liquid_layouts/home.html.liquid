{% comment %}
  home.html.liquid  —  ASI Cayman homepage layout
  Mapped in liquid_layouts.yml as: home -> home

  Sections (per brief):
    1. Header (partial)            5. Audience cards
    2. Hero                        6. Events / News widget area
    3. Impact intro                7. Footer (partial)
    4. Expo 2026 feature  (+ reusable CTA partial)

  netAdventist variable notes:
    - {{ site.name }} / {{ site.description }} are standard.
    - The Events/News widget area (section 6) is where the widgets PRELOADED
      in layouts.yml render. Different netAdventist builds expose container
      output differently, so that section includes a guarded inline fallback
      AND a commented container-output marker. Verify in the Liquid editor and
      keep whichever your instance honors.
{% endcomment %}

{% include 'common/header' %}

<main id="main" class="asi-main" role="main">

  {% comment %} ===================== 2. HERO ===================== {% endcomment %}
  <section class="asi-hero" aria-labelledby="asi-hero-title">
    {% comment %} Optional slideshow background (slideshow extension). Renders
       only when slides exist; otherwise the CSS gradient hero shows. {% endcomment %}
    {% include 'common/slideshow' %}
    <div class="asi-container asi-hero__inner">
      <div class="asi-hero__content">
        <p class="asi-eyebrow asi-eyebrow--light">ASI Cayman</p>
        <h1 class="asi-hero__title" id="asi-hero-title">
          Connecting Adventist Business, Ministry &amp; Community Impact
        </h1>
        <p class="asi-hero__text">
          ASI Cayman is the Cayman Islands chapter of Adventist-Laymen&rsquo;s Services &amp; Industries.
          We connect Seventh-day Adventist business owners, professionals, entrepreneurs, students, and
          service-minded members through ministry, mentorship, health outreach, career development, and
          Christ-centered community impact.
        </p>
        <div class="asi-hero__actions">
          <a class="asi-btn asi-btn--gold asi-btn--lg" href="/expo-registration">Register for Expo 2026</a>
          <a class="asi-btn asi-btn--ghost asi-btn--lg" href="/membership">Become a Member</a>
        </div>
      </div>
    </div>
  </section>

  {% comment %} ================= 3. IMPACT INTRO ================= {% endcomment %}
  <section class="asi-impact" aria-labelledby="asi-impact-title">
    <div class="asi-container">
      <h2 class="asi-section-title" id="asi-impact-title">Our Three-Fold Mission</h2>
      <p class="asi-section-lead">
        Sharing Christ in the marketplace by uniting faith and work across Grand Cayman.
      </p>
      <div class="asi-grid asi-grid--3">
        <article class="asi-impact__item">
          <div class="asi-impact__icon" aria-hidden="true">&#128188;</div>
          <h3 class="asi-impact__title">Business</h3>
          <p>Supporting Adventist-owned businesses, entrepreneurs, and professionals with networking, visibility, and mentorship.</p>
        </article>
        <article class="asi-impact__item">
          <div class="asi-impact__icon" aria-hidden="true">&#128591;</div>
          <h3 class="asi-impact__title">Ministry</h3>
          <p>Sharing Christ in the marketplace through witness, outreach, and a faith that shows up in everyday work.</p>
        </article>
        <article class="asi-impact__item">
          <div class="asi-impact__icon" aria-hidden="true">&#129309;</div>
          <h3 class="asi-impact__title">Service</h3>
          <p>Meeting real needs through health outreach, community service, and career development for the next generation.</p>
        </article>
      </div>
    </div>
  </section>

  {% comment %} ============== 4. EXPO 2026 FEATURE =============== {% endcomment %}
  <section class="asi-feature" aria-labelledby="asi-feature-title">
    <div class="asi-container asi-feature__inner">
      <div class="asi-feature__body">
        <p class="asi-eyebrow">Featured Event</p>
        <h2 class="asi-feature__title" id="asi-feature-title">ASI Cayman Business &amp; Career Expo 2026</h2>
        <p class="asi-feature__text">
          A community-wide expo connecting businesses, professionals, students, and families.
          Explore opportunities, build connections, and be inspired toward Christ-centered impact.
        </p>
        <ul class="asi-feature__facts">
          <li><span class="asi-feature__label">Date</span> Sunday, June 28, 2026</li>
          <li><span class="asi-feature__label">Time</span> 2:00 PM</li>
          <li><span class="asi-feature__label">Venue</span> The Lion Center, Grand Cayman</li>
          <li><span class="asi-feature__label">Admission</span> Free for the public</li>
        </ul>
        <div class="asi-feature__actions">
          <a class="asi-btn asi-btn--gold asi-btn--lg" href="/expo-registration">Register a Booth</a>
          <a class="asi-btn asi-btn--outline asi-btn--lg" href="/expo-2026">Expo Details</a>
        </div>
      </div>

      <aside class="asi-feature__card" aria-label="Exhibitor booth pricing">
        <h3 class="asi-pricecard__title">Exhibitor Booth Pricing</h3>
        <ul class="asi-pricecard__list">
          <li>
            <span class="asi-pricecard__plan">ASI Members</span>
            <span class="asi-pricecard__price">$100</span>
          </li>
          <li>
            <span class="asi-pricecard__plan">Early-Bird <small>(on/before May 31, 2026)</small></span>
            <span class="asi-pricecard__price">$100</span>
          </li>
          <li>
            <span class="asi-pricecard__plan">Regular <small>(after May 31, 2026)</small></span>
            <span class="asi-pricecard__price">$150</span>
          </li>
        </ul>
        <a class="asi-btn asi-btn--gold asi-btn--block" href="/expo-registration">Reserve Your Booth</a>
      </aside>
    </div>
  </section>

  {% comment %} ================ 5. AUDIENCE CARDS ================ {% endcomment %}
  <section class="asi-audience" aria-labelledby="asi-audience-title">
    <div class="asi-container">
      <h2 class="asi-section-title" id="asi-audience-title">There&rsquo;s a Place for You</h2>
      <p class="asi-section-lead">ASI Cayman serves a whole community — find where you fit.</p>
      <div class="asi-grid asi-grid--4">
        <article class="asi-card">
          <h3 class="asi-card__title">For Business Owners</h3>
          <p class="asi-card__text">Grow your network, raise your visibility, and connect faith with enterprise.</p>
          <a class="asi-card__link" href="/membership">Join ASI Cayman &rsaquo;</a>
        </article>
        <article class="asi-card">
          <h3 class="asi-card__title">For Professionals</h3>
          <p class="asi-card__text">Mentor, collaborate, and use your expertise for Christ-centered impact.</p>
          <a class="asi-card__link" href="/membership">Get Involved &rsaquo;</a>
        </article>
        <article class="asi-card">
          <h3 class="asi-card__title">For Students &amp; Youth</h3>
          <p class="asi-card__text">Discover career paths, mentorship, and real-world opportunities at the Expo.</p>
          <a class="asi-card__link" href="/expo-2026">Explore the Expo &rsaquo;</a>
        </article>
        <article class="asi-card">
          <h3 class="asi-card__title">For the Community</h3>
          <p class="asi-card__text">Everyone is welcome — health outreach, service, and free public events.</p>
          <a class="asi-card__link" href="/events">See Events &rsaquo;</a>
        </article>
      </div>
    </div>
  </section>

  {% comment %} ============ 6. EVENTS / NEWS WIDGET AREA ============
     The News widget (content) and Events widget (sidebar) are PRELOADED in
     layouts.yml for the "home" layout. Depending on your netAdventist build,
     they may auto-render into their containers. The markup below is a guarded
     inline fallback so the homepage is never empty. If your instance injects
     the preloaded widgets here automatically, delete the inline loops (or the
     container markers) to avoid duplication.
  {% endcomment %}
  <section class="asi-updates" aria-labelledby="asi-updates-title">
    <div class="asi-container asi-grid asi-grid--sidebar">

      <div class="asi-updates__main container-content" data-asi-container="content">
        <h2 class="asi-section-title" id="asi-updates-title">News &amp; Updates</h2>

        {% comment %} Preferred: container output for the preloaded News widget.
           Uncomment the marker that matches your build, e.g.:
           {{ content_for_content }}  or  {% widget_container 'content' %}
        {% endcomment %}

        {% comment %} Inline fallback — renders if a news collection is available. {% endcomment %}
        {% if news_entries and news_entries.size > 0 %}
          <ul class="asi-newslist">
            {% for news_entry in news_entries limit: 4 %}
              <li class="asi-newslist__item">
                <a class="asi-newslist__link" href="{{ news_entry.url | default: '/news' }}">
                  <h3 class="asi-newslist__title">{{ news_entry.title }}</h3>
                </a>
                {% if news_entry.published_at %}
                  <p class="asi-newslist__date">{{ news_entry.published_at | date: '%B %-d, %Y' }}</p>
                {% endif %}
                <p class="asi-newslist__excerpt">
                  {{ news_entry.body | strip_html | truncatewords: 28 }}
                </p>
              </li>
            {% endfor %}
          </ul>
          <p><a class="asi-btn asi-btn--outline" href="/news">View all updates</a></p>
        {% else %}
          <p class="asi-empty">News &amp; updates will appear here once the News extension is enabled and entries are published.</p>
        {% endif %}
      </div>

      <aside class="asi-updates__side container-sidebar" data-asi-container="sidebar" aria-label="Upcoming events">
        <h2 class="asi-section-title asi-section-title--sm">Upcoming Events</h2>

        {% comment %} Preferred: container output for the preloaded Events widget.
           e.g. {{ content_for_sidebar }} or {% widget_container 'sidebar' %} {% endcomment %}

        {% if events and events.size > 0 %}
          <ul class="asi-eventlist">
            {% for event in events limit: 5 %}
              <li class="asi-eventlist__item">
                {% if event.start_at %}
                  <p class="asi-eventlist__date">{{ event.start_at | date: '%b %-d' }}</p>
                {% endif %}
                <a class="asi-eventlist__link" href="{{ event.url | default: '/events' }}">{{ event.title }}</a>
              </li>
            {% endfor %}
          </ul>
          <p><a class="asi-btn asi-btn--ghost asi-btn--sm" href="/events">All events</a></p>
        {% else %}
          <p class="asi-empty">Events will appear here once the Events extension is enabled.</p>
        {% endif %}
      </aside>

    </div>
  </section>

  {% comment %} ============== Reusable closing CTA ============== {% endcomment %}
  {% include 'common/cta' %}

</main>

{% include 'common/footer' %}
