{
  "name": "ari",
  "version": "0.1.0",
  "private": true,
  "description": "Ari \u2014 your personal AI chief of staff. Cayworks platform.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts",
    "db:studio": "prisma studio",
    "retell:sync": "tsx --env-file-if-exists=.env.local scripts/retell-sync.ts",
    "postinstall": "prisma generate",
    "retell:create-agent": "tsx --env-file-if-exists=.env.local scripts/retell-create-agent.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@auth/prisma-adapter": "^2.7.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "grammy": "^1.30.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=20"
  }
}
