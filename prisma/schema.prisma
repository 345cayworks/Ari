// ============================================================
// Ari — Prisma schema (Phase 0.5)
// Multi-tenant from day 1. You're tenant #1.
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Auth.js core models -----------------------------------------

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  emailVerified  DateTime?
  image          String?
  role           Role      @default(USER)
  telegramUserId String?   @unique
  tenantId       String?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id])
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Ari domain --------------------------------------------------

model Tenant {
  id                 String              @id @default(cuid())
  name               String
  ownerEmail         String
  subscriptionStatus SubscriptionStatus  @default(TRIAL)
  settings           Json                @default("{}")
  systemPromptOverride String?           @db.Text
  users              User[]
  messages           Message[]
  approvals          PendingApproval[]
  facts              Fact[]
  apiUsage           ApiUsage[]
  integrationEvents  IntegrationEvent[]
  polls              Poll[]
  pollCalls          PollCall[]
  doNotCall          DoNotCall[]
  pollCallbacks      PollCallback[]
  pollBatches        PollBatch[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  COMP
}

model Message {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String      @db.Text
  channel   String      @default("telegram")
  meta      Json?
  createdAt DateTime    @default(now())

  @@index([tenantId, createdAt])
}

enum MessageRole {
  user
  assistant
}

model PendingApproval {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind       String         // e.g. "send_email", "send_sms", "send_whatsapp"
  payload    Json
  status     ApprovalStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  resolvedAt DateTime?

  @@index([tenantId, status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EDITED
  CANCELLED
}

model Fact {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject   String
  fact      String   @db.Text
  createdAt DateTime @default(now())

  @@index([tenantId, subject])
}

model ApiUsage {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model        String
  inputTokens  Int
  outputTokens Int
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)
  costUsd      Float
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model IntegrationEvent {
  id          String                 @id @default(cuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration String                 // e.g. "ads_cayworks"
  payload     Json
  status      IntegrationEventStatus @default(QUEUED)
  error       String?
  createdAt   DateTime               @default(now())
  sentAt      DateTime?

  @@index([integration, status])
}

enum IntegrationEventStatus {
  QUEUED
  SENT
  FAILED
}

// --- Polling (Retell voice agents) -------------------------------
// Answers are stored against the call, never against a phone number.
// Numbers are only kept as an HMAC (phoneHash) except where we must
// dial back (PollCallback).

model Poll {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  status         PollStatus     @default(DRAFT)
  retellAgentId  String?        // overrides RETELL_AGENT_ID for this poll
  fromNumber     String?        // overrides RETELL_FROM_NUMBER for this poll
  // Retell dynamic variables injected into the prompt on every call:
  // poll_name, poll_topic, screening_questions, survey_questions, ...
  variables      Json           @default("{}")
  // Raking targets, see lib/polling/weighting.ts (WeightingConfig).
  weighting      Json           @default("{}")
  calls          PollCall[]
  callbacks      PollCallback[]
  batches        PollBatch[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId, status])
  @@index([retellAgentId])
}

enum PollStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model PollCall {
  id                  String          @id @default(cuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pollId              String
  poll                Poll            @relation(fields: [pollId], references: [id], onDelete: Cascade)
  retellCallId        String          @unique
  batchId             String?
  batch               PollBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  retellAgentId       String
  direction           String
  phoneHash           String
  callStatus          String
  outcome             PollCallOutcome @default(IN_PROGRESS)
  consentGiven        Boolean?
  completed           Boolean         @default(false)
  lastQuestionReached String?
  disconnectionReason String?
  durationMs          Int?
  startedAt           DateTime?
  endedAt             DateTime?
  summary             String?         @db.Text
  sentiment           String?
  callSuccessful      Boolean?
  inVoicemail         Boolean?
  // Raw custom_analysis_data from Retell, kept for QA and re-processing.
  analysis            Json?
  responses           PollResponse[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([pollId, outcome])
  @@index([tenantId, createdAt])
  @@index([batchId])
}

enum PollCallOutcome {
  IN_PROGRESS
  COMPLETED
  PARTIAL
  REFUSED
  SCREENED_OUT
  CALLBACK_REQUESTED
  DO_NOT_CALL
  VOICEMAIL
  NO_ANSWER
  WRONG_NUMBER_OR_LANGUAGE
  HOSTILE
  DISTRESSED
  NO_CONVERSATION
}

model PollResponse {
  id         String   @id @default(cuid())
  pollCallId String
  pollCall   PollCall @relation(fields: [pollCallId], references: [id], onDelete: Cascade)
  questionId String   // e.g. "S1", "Q3", "D2"
  answer     String   @db.Text
  verbatim   String?  @db.Text
  source     String   @default("function") // "function" (live) or "analysis" (post-call)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([pollCallId, questionId])
}

model DoNotCall {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneHash String
  reason    String?
  source    String   // "function" | "analysis" | "manual"
  createdAt DateTime @default(now())

  @@unique([tenantId, phoneHash])
}

model PollCallback {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pollId         String
  poll           Poll               @relation(fields: [pollId], references: [id], onDelete: Cascade)
  retellCallId   String             @unique
  phoneNumber    String             // needed to dial back; delete once DONE
  preferredTime  String             // as the respondent said it, e.g. "tomorrow after 6"
  status         PollCallbackStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([tenantId, status])
}

enum PollCallbackStatus {
  PENDING
  DONE
  CANCELLED
}

// A list of numbers sent to Retell batch calling. Large lists are split
// into several Retell batches (retellBatchIds).
model PollBatch {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pollId           String
  poll             Poll            @relation(fields: [pollId], references: [id], onDelete: Cascade)
  name             String
  status           PollBatchStatus @default(SENT)
  retellBatchIds   String[]
  submittedCount   Int             // numbers sent to Retell
  skippedDnc       Int             @default(0)
  skippedCalled    Int             @default(0) // already called for this poll
  skippedInvalid   Int             @default(0) // unparseable or duplicate
  startsAt         DateTime?       // null = as soon as Retell picks it up
  // Calling window in Cayman local time, minutes since midnight.
  windowStart      Int
  windowEnd        Int
  days             String[]        // e.g. ["Monday", ...]; empty = every day
  error            String?
  calls            PollCall[]
  createdAt        DateTime        @default(now())

  @@index([pollId, createdAt])
}

enum PollBatchStatus {
  SENT
  PARTIAL // some chunks failed to send, see error
  FAILED
}
