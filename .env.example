# ============================================================
# Ari — environment variables
# ============================================================

# --- Database (Neon Postgres) ------------------------------------
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# --- Auth (NextAuth v5) ------------------------------------------
NEXTAUTH_SECRET=                    # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# --- SuperAdmin bootstrap ---------------------------------------
SUPER_ADMIN_EMAIL=info@cayworks.com
SUPERADMIN_MASTER_KEY=              # openssl rand -hex 24

# --- AI ----------------------------------------------------------
ANTHROPIC_API_KEY=
ARI_MODEL=claude-sonnet-4-6
ARI_FAST_MODEL=claude-haiku-4-5-20251001
GROQ_API_KEY=                       # https://console.groq.com (free)

# --- Telegram ----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=            # openssl rand -hex 24
ALLOWED_TELEGRAM_USER_IDS=          # comma-separated numeric IDs

# --- Tracking (public, exposed to browser) ----------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- ads.cayworks.com integration -------------------------------
ADS_CAYWORKS_WEBHOOK_URL=https://ads.cayworks.com/api/events
ADS_CAYWORKS_API_KEY=
ADS_CAYWORKS_ENABLED=false

# --- Polling (Retell voice agents) ------------------------------
RETELL_API_KEY=                     # Retell dashboard → API Keys (also verifies webhooks)
RETELL_AGENT_ID=                    # the polling agent (agent_...)
RETELL_FROM_NUMBER=                 # +1345... number bought in / imported to Retell
RETELL_TRANSFER_NUMBER=             # optional: office line for "speak to a person"
PUBLIC_BASE_URL=                    # https://<your-site>.netlify.app (falls back to NEXTAUTH_URL)
PHONE_HASH_SECRET=                  # openssl rand -hex 32 — never change once in use

# --- Phase 2+ (placeholders) ------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
