# --- Required ---
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Comma-separated list of Telegram user IDs allowed to talk to Ari.
# Get yours by messaging @userinfobot on Telegram.
ALLOWED_TELEGRAM_USER_IDS=

# Required for voice notes. Free tier at https://console.groq.com
GROQ_API_KEY=

# --- Optional ---
USER_NAME=
ARI_MODEL=claude-sonnet-4-6
ARI_FAST_MODEL=claude-haiku-4-5-20251001
DB_PATH=./data/ari.db

# Set to "webhook" for production behind a public URL, "polling" for local dev.
TELEGRAM_MODE=polling
PUBLIC_URL=
PORT=8080
